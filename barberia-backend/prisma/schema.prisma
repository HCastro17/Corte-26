generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  BARBERO
  ADMIN
}

enum AccountStatus {
  ACTIVA
  BLOQUEADA
}

enum AppointmentStatus {
  PENDIENTE
  COMPLETADA
  CANCELADA
  AUSENTE
}

model User {
  id            Int           @id @default(autoincrement())
  email         String        @unique
  name          String
  role          Role          @default(CLIENTE)
  birthDate     DateTime?
  points        Int           @default(0)
  strikes       Int           @default(0)
  accountStatus AccountStatus @default(ACTIVA)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointmentsAsClient Appointment[] @relation("ClientAppointments")
  appointmentsAsBarber Appointment[] @relation("BarberAppointments")
}

model Service {
  id              Int           @id @default(autoincrement())
  name            String
  description     String?
  price           Float         
  durationMinutes Int           
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointments    Appointment[]
}

model Appointment {
  id            Int               @id @default(autoincrement())
  startTime     DateTime
  endTime       DateTime          
  status        AppointmentStatus @default(PENDIENTE)
  priceCharged  Float             
  pointsAwarded Int               

  clientId      Int
  client        User              @relation("ClientAppointments", fields: [clientId], references: [id])

  barberId      Int
  barber        User              @relation("BarberAppointments", fields: [barberId], references: [id])

  serviceId     Int
  service       Service           @relation(fields: [serviceId], references: [id])

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}